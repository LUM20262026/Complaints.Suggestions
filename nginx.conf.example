# ============================================================================
# ترويسات الأمان — للنشر على Nginx (أضفه داخل server { ... })
# ============================================================================

server {
    listen 443 ssl http2;
    server_name complaints.example.com;

    # --- ترويسات الأمان ---
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.sheetjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://*.supabase.co; connect-src https://*.supabase.co wss://*.supabase.co https://formsubmit.co; worker-src 'self' blob:; frame-src 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    # بعد التأكد من عمل الموقع عبر HTTPS كاملاً، أزل علامة # :
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # منع الوصول للملفات الداخلية
    location ~ /\.(env|git|htaccess) { deny all; }
    location ~* \.(sql|log|md|bak)$  { deny all; }

    root /var/www/lotus-complaints;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # صفحة الإدارة: بدون تخزين مؤقت في المتصفح
    location = /admin.html {
        add_header Cache-Control "no-store" always;
    }
}
